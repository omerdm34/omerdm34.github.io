---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { notesUi, noteSlug } from '../i18n/notes';
import Flap from './Flap.astro';
import Topbar from './Topbar.astro';
import Icon from './Icon.astro';
import { content, links, type Lang } from '../i18n/content';
import { caseStudies, caseUi, datathonModels } from '../i18n/projects';

import signbridgeHome from '../assets/projects/signbridge-home.png';
import signbridgeGuide from '../assets/projects/signbridge/guide.png';
import signbridgeText from '../assets/projects/signbridge/text.png';
import dcHome from '../assets/projects/dcenergy/home.jpg';
import dcProjects from '../assets/projects/dcenergy/projects.jpg';
import dcMobile from '../assets/projects/dcenergy/mobile.jpg';
import msHome from '../assets/projects/masal/home.jpg';
import msNews from '../assets/projects/masal/news.jpg';
import msMobile from '../assets/projects/masal/mobile.jpg';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = content[lang];
const ui = caseUi[lang];
const all = caseStudies[lang];
const idx = all.findIndex((c) => c.slug === slug);
const c = all[idx];
const next = all[(idx + 1) % all.length];
const U = (v: string) => v.toLocaleUpperCase(lang);
const home = lang === 'tr' ? '/tr/' : '/';
const base = lang === 'tr' ? '/tr/projects/' : '/projects/';
const other = (lang === 'tr' ? '/projects/' : '/tr/projects/') + slug + '/';

const tr = lang === 'tr';
type Shot = { src: ImageMetadata; alt: string; cap: string; kind?: 'phone' | 'browser'; url?: string };
const screensBySlug: Record<string, Shot[]> = {
  'signbridge-ai': [
    { src: signbridgeHome, alt: tr ? 'SignBridgeAI ana ekranı: logo ve özellik menüsü' : 'SignBridgeAI home screen with its logo and feature menu', cap: tr ? 'Ana ekran' : 'Home screen' },
    { src: signbridgeText, alt: tr ? 'Metin modu: yazılan metni çevirme ve seslendirme' : 'Text mode for typing, translating and speaking', cap: tr ? 'Metin modu' : 'Text mode' },
    { src: signbridgeGuide, alt: tr ? 'Kamera rehberi ve ASL alfabe referansı' : 'Camera guide with an ASL alphabet reference', cap: tr ? 'Rehber' : 'Guide' },
  ],
  'dc-energy': [
    { kind: 'browser', url: 'dcenergy.com.tr', src: dcHome, alt: tr ? 'DC Energy ana sayfası: AG-OG, altyapı ve iç tesisat uygulamaları başlığı' : 'DC Energy home page headed by its low and medium voltage, infrastructure and wiring services', cap: tr ? 'Ana sayfa' : 'Home page' },
    { kind: 'browser', url: 'dcenergy.com.tr/projeler', src: dcProjects, alt: tr ? 'Kategoriye göre süzülebilen proje kartları' : 'Project cards that can be filtered by category', cap: tr ? 'Projeler, panelden yönetiliyor' : 'Projects, managed from the panel' },
    { kind: 'phone', src: dcMobile, alt: tr ? 'DC Energy ana sayfasının telefondaki görünümü' : 'DC Energy home page on a phone', cap: tr ? 'Telefonda' : 'On a phone' },
  ],
  'masal-bahcesi': [
    { kind: 'browser', url: 'masalbahcesimaras.com', src: msHome, alt: tr ? 'Masal Bahçesi ana sayfası: arama ve WhatsApp düğmeleriyle karşılama bölümü' : 'Masal Bahçesi home page with call and WhatsApp buttons', cap: tr ? 'Ana sayfa' : 'Home page' },
    { kind: 'browser', url: 'masalbahcesimaras.com/duyurular', src: msNews, alt: tr ? 'Yöneticinin panelden yayınladığı duyurular' : 'Announcements the owner published from the panel', cap: tr ? 'Panelden yayınlanan duyurular' : 'Announcements published from the panel' },
    { kind: 'phone', src: msMobile, alt: tr ? 'Masal Bahçesi ana sayfasının telefondaki görünümü' : 'Masal Bahçesi home page on a phone', cap: tr ? 'Telefonda' : 'On a phone' },
  ],
};
const screens = screensBySlug[slug] ?? [];
const note = (await getCollection('notes', (n) => n.id.startsWith(lang + '/') && n.data.project === slug))[0];
const noteHref = note ? home + 'notes/' + noteSlug(note.id) + '/' : '';
const web = screens.some((s) => s.kind === 'browser');
const maxMse = datathonModels[0].mse;
const fmt = (n: number) => n.toLocaleString(lang === 'tr' ? 'tr-TR' : 'en-US', { maximumFractionDigits: 2 });
---
<Topbar lang={lang} other={other} solid />

<main id="main" class="case">
  <section class="case__head wrap">
    <a class="case__back" href={home + '#p-' + c.homeId}><Icon name="arrow" class="icon case__back-icon" />{U(ui.back)}</a>
    <div class="proj__meta case__meta">
      <Flap text={c.code} class="flaps--sm" />
      <span class="proj__date">{U(ui.caseStudy)} · {c.date}</span>
      <Flap text={c.status} class="flaps--sm status" />
    </div>
    <h1 class="case__title"><Flap text={U(c.name)} class="flaps--lg" /></h1>
    <p class="case__lede" data-reveal="left">{c.lede}</p>
    <dl class="facts case__facts" data-reveal="right">
      {c.facts.map((f) => <div class="facts__row"><dt>{U(f.k)}</dt><dd>{f.v}</dd></div>)}
    </dl>
  </section>

  {screens.length > 0 && (
    <section class="case__screens" aria-label={ui.gallery}>
      <ul class:list={['screens wrap', web && 'screens--web']}>
        {screens.map((s, i) => (
          <li class:list={['screens__item', s.kind === 'browser' && 'screens__item--browser']} data-reveal="up" style={`--d:${i * 110}ms`}>
            {s.kind === 'browser' ? (
              <div class="browser">
                <div class="browser__bar" aria-hidden="true"><i /><i /><i /><span>{s.url}</span></div>
                <Image src={s.src} alt={s.alt} widths={[560, 900, 1400]} sizes="(min-width: 900px) 40vw, 92vw" />
              </div>
            ) : (
              <div class="phone"><Image src={s.src} alt={s.alt} widths={[320, 560]} sizes="(min-width: 900px) 22vw, 70vw" /></div>
            )}
            <span class="screens__cap">{U(s.cap)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {slug === 'datathon-2026' && (
    <section class="case__section wrap" aria-labelledby="models-h">
      <h2 id="models-h" class="more__h" data-reveal="left">{U(ui.models)}</h2>
      <ol class="chart__bars case__models">
        {datathonModels.map((m, i) => (
          <li class:list={['bar', 'bar--wide', i === datathonModels.length - 1 && 'bar--win']} style={`--v:${m.mse / maxMse};--d:${i * 50}ms`} data-reveal="right">
            <span class="bar__label">{lang === 'tr' ? m.nameTr : m.name}</span>
            <span class="bar__track"><span class="bar__fill" /></span>
            <span class="bar__val">{fmt(m.mse)}</span>
          </li>
        ))}
      </ol>
      <p class="case__note">{c.resultsNote}</p>
    </section>
  )}

  <section class="case__section wrap case__split" aria-labelledby="problem-h">
    <h2 id="problem-h" class="more__h" data-reveal="left">{U(ui.problem)}</h2>
    <div class="case__prose" data-reveal="up">{c.problem.map((p) => <p>{p}</p>)}</div>
  </section>

  <section class="case__section wrap" aria-labelledby="approach-h">
    <h2 id="approach-h" class="more__h" data-reveal="left">{U(ui.approach)}</h2>
    <ol class="route">
      {c.steps.map((s, i) => (
        <li class="route__stop" data-reveal="right" style={`--d:${i * 60}ms`}>
          <span class="route__gate" aria-hidden="true"><Flap text={String(i + 1).padStart(2, '0')} class="flaps--md" /></span>
          <div>
            <h3 class="route__title">{U(s.title)}</h3>
            <p class="route__text">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="case__section wrap" aria-labelledby="results-h">
    <h2 id="results-h" class="more__h" data-reveal="left">{U(ui.results)}</h2>
    <ul class="readouts">
      {c.results.map((r, i) => (
        <li class="readout" data-reveal="up" style={`--d:${i * 90}ms`}>
          <Flap text={r.value} class="flaps--lg readout__value" />
          <span class="readout__label">{r.label}</span>
        </li>
      ))}
    </ul>
    {slug !== 'datathon-2026' && c.resultsNote && <p class="case__note">{c.resultsNote}</p>}
  </section>

  <section class="case__section wrap case__split" aria-labelledby="learned-h">
    <h2 id="learned-h" class="more__h" data-reveal="left">{U(ui.learned)}</h2>
    <ul class="ticks case__learned" data-reveal="up">{c.learned.map((l) => <li>{l}</li>)}</ul>
  </section>

  <section class="case__section wrap case__split" aria-labelledby="stack-h">
    <h2 id="stack-h" class="more__h" data-reveal="left">{U(ui.stack)}</h2>
    <div data-reveal="up">
      <ul class="tags">{c.stack.map((s) => <li>{s}</li>)}</ul>
      {c.links.map((l) => (
        <a class="proj__link" href={l.href} target="_blank" rel="noopener">{l.label}<Icon name="external" /></a>
      ))}
      {note && (
        <a class="note__project-link case__note" href={noteHref}>
          <span class="case__note-label">{U(notesUi[lang].heading)}</span>
          <span class="case__note-title">{note.data.title}</span>
          <Icon name="arrow" />
        </a>
      )}
    </div>
  </section>

  <a class="case__next" href={base + next.slug + '/'}>
    <span class="case__next-label">{U(ui.next)}</span>
    <span class="case__next-name">{U(next.name)}<Icon name="arrow" class="icon case__next-icon" /></span>
  </a>
</main>

<footer class="footer wrap">
  <span>© 2026 · {t.footer.built}</span>
  <a href={home}>{t.footer.top === 'Back to top' ? 'Home' : 'Ana sayfa'}</a>
</footer>

<script>
  import '../scripts/main';
</script>
