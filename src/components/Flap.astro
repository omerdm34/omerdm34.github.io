---
interface Props {
  text: string;
  as?: 'span' | 'h1' | 'h2' | 'h3' | 'p';
  class?: string;
  pad?: number;
}
const { text, as: Tag = 'span', class: cls = '', pad = 0 } = Astro.props;
// Words stay unbroken; each blank cell rides at the end of the word before it,
// so a wrapped line never starts with an empty tile.
const padded = text.padEnd(pad, ' ');
const groups: string[] = [];
for (const part of padded.split(/( )/).filter((w) => w !== '')) {
  if (part === ' ' && groups.length) groups[groups.length - 1] += ' ';
  else groups.push(part);
}
---
<Tag class:list={['flaps', cls]} data-flap>
  <span class="sr-only">{text}</span>
  <span class="flaps__cells" aria-hidden="true">{groups.map((g) => (
    <span class="flaps__word">{[...g].map((c) =>
      c === ' ' ? <span class="cell cell--blank" data-c=" ">{' '}</span> : <span class="cell" data-c={c}>{c}</span>
    )}</span>
  ))}</span>
</Tag>
