---
interface Props {
  text: string;
  as?: 'span' | 'h1' | 'h2' | 'h3' | 'p';
  class?: string;
  pad?: number;
}
const { text, as: Tag = 'span', class: cls = '', pad = 0 } = Astro.props;
// Words stay unbroken; lines may only wrap at the blank cell between words.
const padded = text.padEnd(pad, ' ');
const words = padded.split(/( )/).filter((w) => w !== '');
---
<Tag class:list={['flaps', cls]} data-flap>
  <span class="sr-only">{text}</span>
  <span class="flaps__cells" aria-hidden="true">{words.map((w) =>
    w === ' '
      ? <span class="cell cell--blank" data-c=" ">{' '}</span>
      : <span class="flaps__word">{[...w].map((c) => <span class="cell" data-c={c}>{c}</span>)}</span>
  )}</span>
</Tag>
