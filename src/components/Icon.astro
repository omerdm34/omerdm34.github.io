---
interface Props { name: 'arrow' | 'arrow-down' | 'download' | 'github' | 'linkedin' | 'kaggle' | 'instagram' | 'mail' | 'plane' | 'external'; class?: string; }
const { name, class: cls = 'icon' } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" stroke-linejoin="miter">
  {name === 'arrow' && <path d="M3 12h16M13 5l7 7-7 7" />}
  {name === 'arrow-down' && <path d="M12 3v16M5 13l7 7 7-7" />}
  {name === 'external' && <path d="M7 17 17 7M9 7h8v8" />}
  {name === 'download' && <path d="M12 3v12M6 10l6 6 6-6M4 21h16" />}
  {name === 'mail' && <><path d="M3 5h18v14H3z" /><path d="m3 6 9 7 9-7" /></>}
  {name === 'plane' && <path d="M2.5 13.5 21 7.5c.8-.3 1.3.8.6 1.3L9 17l-2.5 4-1-.2.6-4.6-3.9-1.6Z" stroke-linejoin="round" />}
  {name === 'github' && <path stroke-linecap="round" stroke-linejoin="round" d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />}
  {name === 'linkedin' && <><path d="M4 9h4v11H4zM6 4.5v.5" /><path d="M11 20v-6.5a3 3 0 0 1 6 0V20M11 9v11" /></>}
  {name === 'instagram' && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="3.8" /><path d="M17 7v.01" /></>}
  {name === 'kaggle' && <path d="M6 3v18M17 3l-8 9 8.5 9M9.5 12.5" />}
</svg>
