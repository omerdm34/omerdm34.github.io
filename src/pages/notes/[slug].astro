---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Note from '../../components/Note.astro';
import { noteSlug } from '../../i18n/notes';

export async function getStaticPaths() {
  const notes = await getCollection('notes', (n) => n.id.startsWith('en/'));
  return notes.map((entry) => ({ params: { slug: noteSlug(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
const slug = noteSlug(entry.id);
---
<Base lang="en" title={`${entry.data.title} · Ömer Faruk Erdem`} description={entry.data.description} path={`/notes/${slug}/`} altPath={`/tr/notes/${slug}/`}>
  <Note lang="en" entry={entry} />
</Base>
