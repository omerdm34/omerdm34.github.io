---
import Base from '../../../layouts/Base.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { caseStudies } from '../../../i18n/projects';

export function getStaticPaths() {
  return caseStudies.tr.map((c) => ({ params: { slug: c.slug } }));
}
const { slug } = Astro.params;
const c = caseStudies.tr.find((x) => x.slug === slug)!;
---
<Base lang="tr" title={c.title} description={c.description} path={`/tr/projects/${slug}/`} altPath={`/projects/${slug}/`}>
  <CaseStudy lang="tr" slug={slug!} />
</Base>
